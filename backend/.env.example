# Biến môi trường của backend (ASP.NET Core không tự đọc tệp .env).
# Chạy local: đặt trong launchSettings.json. Triển khai: đặt ở biến môi trường của nơi chạy.
# Tệp này chỉ liệt kê tên biến; không điền giá trị bí mật vào đây.

# 3 origin của 3 Web (quản lý, nhân viên, khách hàng), ngăn cách bằng dấu phẩy, không có dấu / ở cuối.
Cors__AllowedOrigins=http://localhost:3000,http://localhost:3001,http://localhost:3002

# Mức log tối thiểu của Serilog: Verbose, Debug, Information, Warning, Error, Fatal. Không đặt thì dùng giá trị trong appsettings.json (Information).
Serilog__MinimumLevel=Information
# Khóa ký JWT (BÍ MẬT, tối thiểu 32 ký tự). Chỉ đặt ở biến môi trường của máy/nơi triển khai; không điền giá trị thật vào repo và không đặt trong launchSettings.json (tệp này được commit).
Jwt__SigningKey=
# Thời hạn access token (phút) và refresh token (ngày). Đã có giá trị trong appsettings.json (15 và 7); đặt biến này chỉ khi cần đổi.
Jwt__AccessTokenMinutes=15
Jwt__RefreshTokenDays=7
# Giới hạn số request mỗi phút: nhóm ẩn danh (đăng ký, đăng nhập, làm mới token) tính theo IP; đặt lịch tính theo tài khoản. Đã có giá trị trong appsettings.json (10 và 10); đặt biến này chỉ khi cần đổi.
RateLimit__AuthPermitPerMinute=10
RateLimit__BookingPermitPerMinute=10
# Múi giờ của cửa hàng (tên IANA), dùng để đổi ngày + giờ mốc đặt lịch spa sang UTC. Đã có giá trị trong appsettings.json (Asia/Ho_Chi_Minh); đặt biến này chỉ khi cần đổi.
App__TimeZone=Asia/Ho_Chi_Minh
# Tài khoản Quản lý đầu tiên (R-02): chỉ đặt khi triển khai lần đầu, tạo xong thì gỡ cả hai biến khỏi môi trường. UserName là số điện thoại, tối đa 20 ký tự. Mật khẩu tối thiểu 6 ký tự, có chữ hoa, chữ thường, chữ số, ký tự đặc biệt. Không điền giá trị thật vào repo.
Seed__ManagerUserName=
Seed__ManagerPassword=

# Supabase Storage lưu ảnh minh chứng. Url dạng https://<project-ref>.supabase.co (không có /storage/v1). Bucket là bucket RIÊNG TƯ đã tạo trên Supabase. ServiceKey là khóa service_role (BÍ MẬT, chỉ đặt ở biến môi trường, không commit).
Storage__Url=
Storage__ServiceKey=
Storage__Bucket=

# Cổng thanh toán VNPAY sandbox (FR-PAY-03). TmnCode và HashSecret lấy từ email đăng ký sandbox VNPAY; HashSecret là BÍ MẬT, chỉ đặt ở biến môi trường, không commit. ReturnUrl là địa chỉ Web khách hàng mà VNPAY đưa khách quay lại sau khi thanh toán.
Payment__Vnpay__TmnCode=
Payment__Vnpay__HashSecret=
Payment__Vnpay__ReturnUrl=http://localhost:3002

